{
  "mode": "status",
  "note": "mode=status：各項目を「済」「これから」「不要」で記録する。rec：対応の記録の相手の種類（実際にした記録があれば「記録あり」と出し、済として扱う）。doneIf：診断の答えから済とわかる条件。",
  "items": [
    { "id": "cl_datetime", "priority": 100, "text": "困りごとが起きた日時を記録した", "when": { "fact": "situation", "in": ["B", "C", "D"] } },
    { "id": "cl_detail", "priority": 95, "text": "被害の様子（音の内容、ごみの状態など）を整理した", "when": { "all": [ { "fact": "situation", "in": ["B", "C", "D"] }, { "not": { "fact": "problems", "has": "none" } } ] } },
    { "id": "cl_sign", "priority": 90, "text": "玄関などの[[標識]]を、道路から確認した", "when": {"all":[{"fact":"situation","in":["B","C"]},{"not":{"fact":"reasons","has":"no_sign"}}]} },
    { "id": "cl_list", "priority": 88, "text": "自治体が公開している施設の一覧を確認した（資料の時点も見た）", "when": { "all": [{ "any": [{ "fact": "situation", "eq": "C" }, { "all": [{ "fact": "situation", "eq": "A" }, { "not": { "fact": "stage", "in": ["meeting_planned", "meeting_done", "requested"] } }] }, { "fact": "know", "has": "none" }] }, { "not": { "any": [{ "fact": "checked_list", "eq": "yes" }, { "fact": "reasons", "has": "not_listed" }] } }] } },
    { "id": "cl_type", "priority": 85, "text": "施設の営業の種類（届出・旅館業・特区）を確認した", "when": { "fact": "situation", "in": ["A", "B", "C", "D"] }, "doneIf": { "fact": "biz_type", "in": ["jutaku", "ryokan", "tokku"] } },
    { "id": "cl_contact", "priority": 80, "text": "管理者・運営者の連絡先を確認した", "when": { "fact": "situation", "in": ["A", "B"] }, "rec": ["manager"], "doneIf": { "fact": "done", "has": "manager" } },
    { "id": "cl_manager", "priority": 75, "text": "管理者・運営者に連絡した", "when": { "fact": "situation", "eq": "B" } },
    { "id": "cl_owner_side", "priority": 74, "text": "管理組合・管理会社・大家さんに伝えた", "when": { "fact": "building", "in": ["same_condo", "same_rental"] } },
    { "id": "cl_kiyaku", "priority": 73, "text": "管理規約（賃貸なら契約）で民泊が認められているか確認した", "when": { "fact": "building", "in": ["same_condo", "same_rental"] } },
    { "id": "cl_a_record", "priority": 72, "text": "建物の場所と、掲示・チラシの内容を記録した", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "not": { "fact": "stage", "in": ["meeting_done", "requested"] } }] } },
    { "id": "cl_ordinance", "priority": 70, "text": "自治体の条例・ルール（区域・期間・事前の周知）を確認した", "when": { "fact": "situation", "in": ["A", "E"] } },
    { "id": "cl_a_ask", "priority": 68, "text": "事業者に、苦情の連絡先とごみ・騒音の対策をたずねた", "when": { "all": [ { "fact": "situation", "eq": "A" }, { "fact": "goal", "eq": "request" } ] } },
    { "id": "cl_gov", "priority": 65, "text": "自治体の担当窓口に相談した", "when": { "fact": "situation", "in": ["B", "C", "D"] } },
    { "id": "cl_gov_log", "priority": 60, "text": "相談した日時・部署・担当者・回答の内容を記録した", "when": { "any": [{ "fact": "situation", "in": ["B", "C", "D"] }, { "all": [{ "fact": "situation", "eq": "A" }, { "any": [{ "fact": "done", "has": "gov" }, { "fact": "pre_response", "in": ["gov_ok", "gov_cannot"] }, { "fact": "checked_gov", "eq": "yes" }] }] }] }, "rec": ["gov"] },
    { "id": "cl_writing", "priority": 55, "text": "あいまいな回答は、文書で問い合わせ直した", "when": { "fact": "gov_response", "in": ["legal_ok", "no_change", "no_reply", "not_ours"] } },
    { "id": "cl_improve", "priority": 50, "text": "その後、改善したかを確認した", "when": { "fact": "situation", "in": ["B", "C", "D"] } },
    { "id": "cl_e_compare", "priority": 68, "text": "他の自治体のルールと比べた", "when": { "fact": "situation", "eq": "E" } },
    { "id": "cl_e_voice", "priority": 66, "text": "困りごとの記録や住民の声をまとめた", "when": { "fact": "situation", "eq": "E" } },
    { "id": "cl_e_giin", "priority": 64, "text": "地元の議員に相談した", "when": { "fact": "situation", "eq": "E" } },
    { "id": "cl_e_deadline", "priority": 62, "text": "議会やパブコメの締め切りを確認した", "when": { "fact": "situation", "eq": "E" } },
    { "id": "cl_next", "priority": 10, "text": "必要に応じて、次の対応を考えた", "when": { "not": { "fact": "situation", "eq": "A" } } },
    { "id": "cl_a_status", "priority": 99, "text": "自治体（保健所・担当課）に、申請・届出の状況を確かめた", "when": { "fact": "situation", "eq": "A" }, "rec": ["gov"], "doneIf": { "any": [{ "fact": "done", "has": "gov" }, { "fact": "checked_gov", "eq": "yes" }] } },
    { "id": "cl_a_jichikai", "priority": 69, "text": "自治会長・町会長に相談した", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "not": { "fact": "goal", "in": ["info"] } }] }, "rec": ["jichikai"], "doneIf": { "fact": "done", "has": "jichikai" } },
    { "id": "cl_a_voices", "priority": 67, "text": "近所の住民の意見（心配ごと・望む対策）を集めた", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "not": { "fact": "goal", "in": ["info"] } }] }, "rec": ["neighbors"] },
    { "id": "cl_a_questions", "priority": 66, "text": "説明会の質問書を作った・出した", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "any": [{ "fact": "stage", "in": ["meeting_planned"] }, { "all": [{ "fact": "stage", "in": ["heard"] }, { "fact": "notice", "eq": "yes" }] }] }] }, "rec": ["meeting"] },
    { "id": "cl_a_attend", "priority": 64, "text": "役所の職員や議員に、説明会への同席を頼んだ", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "fact": "stage", "in": ["meeting_planned"] }] }, "rec": ["giin"] },
    { "id": "cl_a_recording", "priority": 63, "text": "録音と議事録の準備をした（録音することは主催者に伝える）", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "fact": "stage", "in": ["meeting_planned"] }] } },
    { "id": "cl_a_written", "priority": 62, "text": "答えのなかった質問について、期限をつけて文書での回答を求めた", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "any": [{ "fact": "stage", "in": ["meeting_done", "requested"] }, { "fact": "meeting_issue", "in": ["unanswered", "no_minutes"] }] }] } },
    { "id": "cl_a_safety", "priority": 61, "text": "建築・消防・用途地域のきまりを、担当部署に確かめてもらった", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "any": [{ "fact": "problems", "in": ["safety"] }, { "fact": "goal", "in": ["stop"] }, { "fact": "pre_response", "in": ["gov_ok"] }] }] } },
    { "id": "cl_a_basis", "priority": 60, "text": "「問題ない」の根拠（どの法律・条例・基準か）を確かめた", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "fact": "pre_response", "in": ["gov_ok"] }] } },
    { "id": "cl_a_agreement", "priority": 58, "text": "約束した対策を、協定書・覚書にするよう求めた", "when": { "all": [{ "fact": "situation", "eq": "A" }, { "any": [{ "fact": "goal", "in": ["request"] }, { "fact": "stage", "in": ["meeting_done", "near_open"] }, { "fact": "meeting_issue", "in": ["verbal"] }, { "fact": "pre_response", "in": ["opening", "refused"] }] }] } },
    {
      "id": "cl_shobo",
      "priority": 62,
      "text": "火事への備えについて、消防署（予防課）に確かめてもらった",
      "when": { "all": [{ "fact": "situation", "in": ["B", "C", "D"] }, { "fact": "problems", "has": "safety" }] }
    }
  ]
}
