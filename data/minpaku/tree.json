{
  "domain": "minpaku",
  "title": "民泊・宿泊施設の困りごと",
  "version": "2026-11-11",
  "start": "situation",
  "maxQuestions": 8,
  "optionSets": {
    "building": [
      { "value": "same_condo", "label": "自分が住む分譲マンションの中の部屋", "short": "同じ分譲マンション内" },
      { "value": "same_rental", "label": "自分が住む賃貸マンション・アパートの中の部屋", "short": "同じ賃貸住宅内" },
      { "value": "house", "label": "近所の一戸建て", "short": "近所の一戸建て" },
      { "value": "other_apartment", "label": "近所の別のマンション・アパートの部屋", "short": "近所の集合住宅" },
      { "value": "unknown", "label": "わからない", "short": "建物は不明" }
    ],
    "problems": [
      { "value": "noise", "label": "騒音（話し声・音楽・キャリーケースの音など）", "short": "騒音" },
      { "value": "gomi", "label": "ごみ（出し方・置き場所・量）", "short": "ごみ" },
      { "value": "smell", "label": "におい・たばこ", "short": "におい" },
      { "value": "traffic", "label": "交通・駐車（路上駐車、タクシーの停車など）", "short": "交通・駐車" },
      { "value": "security", "label": "防犯・不安（知らない人の出入り、鍵の受け渡しなど）", "short": "防犯・不安" },
      { "value": "other", "label": "その他", "short": "その他" }
    ],
    "done": [
      { "value": "manager", "label": "施設の管理者・運営者に連絡した", "short": "管理者に連絡" },
      { "value": "gov", "label": "自治体（保健所・民泊の担当課など）に相談した", "short": "自治体に相談" },
      { "value": "police", "label": "警察に相談・通報した", "short": "警察に相談" },
      {
        "value": "owner_side",
        "label": "マンションの管理組合・管理会社・大家さんに伝えた",
        "short": "管理組合などに伝えた",
        "when": { "not": {"fact": "building", "in": ["house", "other_apartment"]} }
      },
      { "value": "none", "label": "まだ何もしていない", "short": "まだ何もしていない", "exclusive": true }
    ],
    "govResponse": [
      { "value": "acted", "label": "調べて対応すると言われた／対応してくれた", "short": "対応すると回答" },
      { "value": "not_ours", "label": "「担当ではない」と言われた", "short": "担当ではないと回答" },
      { "value": "legal_ok", "label": "「法律上は問題ない」と言われた", "short": "問題ないと回答" },
      { "value": "no_change", "label": "「指導する」と言われたが、変わらない", "short": "指導後も変化なし" },
      { "value": "no_reply", "label": "返事がない", "short": "返事がない" },
      { "value": "forgot", "label": "覚えていない・その他", "short": "回答は不明" }
    ]
  },
  "nodes": {
    "situation": {
      "type": "choice",
      "fact": "situation",
      "sum": "状況",
      "text": "今の状況にいちばん近いものは？",
      "help": "あとから戻って選び直せます。",
      "options": [
        { "value": "A", "label": "近所に民泊ができるらしい", "short": "近所に民泊ができる予定", "next": "a_building" },
        { "value": "B", "label": "すでに営業していて困っている", "short": "営業中の民泊で困っている", "next": "b_problems" },
        { "value": "C", "label": "無許可営業ではないかと疑っている", "short": "無許可営業の疑い", "next": "c_reasons" },
        { "value": "D", "label": "役所に相談したが対応してもらえない", "short": "役所が対応してくれない", "next": "d_where" },
        { "value": "E", "label": "自治体の民泊ルールを変えたい", "short": "自治体のルールを変えたい", "next": "e_what" }
      ]
    },
    "a_building": {
      "type": "choice",
      "fact": "building",
      "sum": "建物",
      "optionSet": "building",
      "text": "民泊ができるらしい建物は、どれですか？",
      "help": "分譲マンションの中なら、マンションのルール（[[管理規約]]）が大きく関係します。",
      "next": "a_notice"
    },
    "a_notice": {
      "type": "yesno",
      "fact": "notice",
      "sum": "事業者からの説明・掲示",
      "text": "事業者から説明やお知らせ（説明会、チラシ、建物への掲示など）はありましたか？",
      "help": "自治体によっては、開業前に近所へ知らせることを求めるルールがあります。",
      "next": "a_worries"
    },
    "a_worries": { "type": "multi", "fact": "problems", "sum": "心配なこと", "optionSet": "problems", "text": "心配していることは？（いくつでも）", "next": "a_checked" },
    "a_checked": { "type": "yesno", "fact": "checked_gov", "sum": "自治体への確認", "text": "その建物の[[届出]]や[[許可]]の申請が出ているか、自治体に問い合わせましたか？", "next": "a_goal" },
    "a_goal": {
      "type": "choice",
      "fact": "goal",
      "sum": "望むこと",
      "text": "いちばん望むことは？",
      "options": [
        { "value": "info", "label": "どんな施設になるのか、正しい情報を知りたい", "short": "情報を知りたい" },
        { "value": "request", "label": "事業者に、ごみ・騒音などの対策をお願いしたい", "short": "事業者に対策をお願いしたい" },
        { "value": "rule", "label": "地域の民泊のルールそのものを変えたい", "short": "ルールを変えたい" }
      ],
      "next": "@result"
    },
    "b_problems": {
      "type": "multi",
      "fact": "problems",
      "sum": "困っていること",
      "optionSet": "problems",
      "text": "困っていることは？（いくつでも）",
      "help": "今まさに危険なことが起きているときは、上の赤いボタンを押してください。",
      "next": "b_ongoing"
    },
    "b_ongoing": {
      "type": "yesno",
      "fact": "ongoing",
      "sum": "今も続いているか",
      "text": "その困りごとは、今も続いていますか？",
      "help": "ここ1か月ほどの間に起きていれば「はい」を選んでください。",
      "next": "b_building"
    },
    "b_building": { "type": "choice", "fact": "building", "sum": "建物", "optionSet": "building", "text": "その民泊がある建物は、どれですか？", "next": "b_know" },
    "b_know": {
      "type": "multi",
      "fact": "know",
      "sum": "施設について分かっていること",
      "text": "施設について分かっていることは？（いくつでも）",
      "help": "[[標識]]は、玄関など外から見える場所に出ている札です。建物の外（道路など）から見える範囲で確かめてください。",
      "options": [
        { "value": "sign", "label": "玄関などに標識（届出番号など）が出ている", "short": "標識あり" },
        { "value": "contact", "label": "管理者・運営会社の連絡先がわかる", "short": "連絡先がわかる" },
        { "value": "listing", "label": "仲介サイト（予約サイト）に載っているのを見た", "short": "予約サイトに掲載あり" },
        { "value": "none", "label": "何も分からない", "short": "何も分からない", "exclusive": true }
      ],
      "next": "b_done"
    },
    "b_done": {
      "type": "multi",
      "fact": "done",
      "sum": "これまでにしたこと",
      "optionSet": "done",
      "text": "これまでにしたことは？（いくつでも）",
      "next": [{"if": {"fact": "done", "has": "gov"}, "go": "b_gov_response"}, {"if": {"fact": "done", "has": "none"}, "go": "@result"}, {"go": "b_outcome"}]
    },
    "b_gov_response": { "type": "choice", "fact": "gov_response", "sum": "自治体の回答", "optionSet": "govResponse", "text": "自治体からは、どんな回答でしたか？", "next": "b_outcome" },
    "b_outcome": {
      "type": "choice",
      "fact": "outcome",
      "sum": "その結果",
      "text": "その後、困りごとはどうなりましたか？",
      "options": [
        { "value": "improved", "label": "よくなった", "short": "よくなった" },
        { "value": "partial", "label": "一部はよくなったが、まだ困っている", "short": "一部よくなった" },
        { "value": "temporary", "label": "一時的によくなったが、元に戻った", "short": "一時的に改善して元に戻った" },
        { "value": "same", "label": "変わらない", "short": "変わらない" },
        { "value": "worse", "label": "悪くなった", "short": "悪くなった" }
      ],
      "next": "@result"
    },
    "c_reasons": {
      "type": "multi",
      "fact": "reasons",
      "sum": "そう思う理由",
      "text": "無許可ではないかと思う理由は？（いくつでも）",
      "help": "ここで選んだだけで「無許可」と決まるわけではありません。確かめる順番を、結果でご案内します。",
      "options": [
        { "value": "no_sign", "label": "玄関などに標識が見当たらない", "short": "標識が見当たらない" },
        { "value": "not_listed", "label": "自治体が公開している施設の一覧に見当たらない", "short": "公開一覧に見当たらない" },
        { "value": "no_number", "label": "予約サイトに届出番号などが書かれていない", "short": "予約サイトに番号がない" },
        { "value": "all_year", "label": "1年中、毎日のように宿泊客が来ているようだ", "short": "1年中営業していそう" },
        { "value": "other", "label": "その他", "short": "その他" }
      ],
      "next": [{"if": {"fact": "reasons", "has": "not_listed"}, "go": "c_building"}, {"go": "c_checked_list"}]
    },
    "c_checked_list": {
      "type": "yesno",
      "fact": "checked_list",
      "sum": "公開一覧の確認",
      "text": "自治体が公開している「民泊（届出住宅）」や「旅館業の施設」の一覧を確認しましたか？",
      "help": "多くの自治体が、届出・許可を受けた施設の一覧をホームページで公開しています。結果画面で探し方をご案内します。",
      "next": "c_building"
    },
    "c_building": { "type": "choice", "fact": "building", "sum": "建物", "optionSet": "building", "text": "その施設がある建物は、どれですか？", "next": "c_problems" },
    "c_problems": {
      "type": "multi",
      "fact": "problems",
      "sum": "困っていること",
      "text": "困っていることは？（いくつでも）",
      "optionSet": "problems",
      "extraOptions": [{"value": "none", "label": "特に困っていないが、ルールが守られているか確かめたい", "short": "困りごとはないが確かめたい", "exclusive": true}],
      "next": "c_done"
    },
    "c_done": {
      "type": "multi",
      "fact": "done",
      "sum": "これまでにしたこと",
      "optionSet": "done",
      "text": "これまでにしたことは？（いくつでも）",
      "next": [{"if": {"fact": "done", "has": "gov"}, "go": "c_gov_response"}, {"go": "@result"}]
    },
    "c_gov_response": { "type": "choice", "fact": "gov_response", "sum": "自治体の回答", "optionSet": "govResponse", "text": "自治体からは、どんな回答でしたか？", "next": "@result" },
    "d_where": {
      "type": "choice",
      "fact": "gov_where",
      "sum": "相談した先",
      "text": "どこに相談しましたか？",
      "help": "複数ある場合は、いちばん最近のところを選んでください。",
      "options": [
        { "value": "hoken", "label": "保健所・生活衛生の担当", "short": "保健所・生活衛生" },
        { "value": "minpaku_dept", "label": "民泊・観光の担当課", "short": "民泊・観光の担当課" },
        { "value": "env", "label": "ごみ・環境の担当", "short": "ごみ・環境の担当" },
        { "value": "police", "label": "警察", "short": "警察" },
        { "value": "other", "label": "その他・わからない", "short": "相談先は不明" }
      ],
      "next": "d_method"
    },
    "d_method": {
      "type": "choice",
      "fact": "gov_method",
      "sum": "相談の方法",
      "text": "どの方法で相談しましたか？",
      "options": [
        { "value": "phone", "label": "電話", "short": "電話" },
        { "value": "counter", "label": "窓口に行った", "short": "窓口" },
        { "value": "mail", "label": "メール・問い合わせフォーム", "short": "メール・フォーム" },
        { "value": "letter", "label": "文書（郵送・手渡し）", "short": "文書" }
      ],
      "next": "d_response"
    },
    "d_response": {
      "type": "choice",
      "fact": "gov_response",
      "sum": "回答の内容",
      "text": "どんな回答でしたか？",
      "options": [
        { "value": "not_ours", "label": "「担当ではない」と言われた", "short": "担当ではないと回答" },
        { "value": "legal_ok", "label": "「法律上は問題ない」と言われた", "short": "問題ないと回答" },
        { "value": "no_change", "label": "「指導する」と言われたが、変わらない", "short": "指導後も変化なし" },
        { "value": "no_reply", "label": "返事がない・放っておかれている", "short": "返事がない" },
        { "value": "forgot", "label": "覚えていない・その他", "short": "回答は不明" }
      ],
      "next": "d_recorded"
    },
    "d_recorded": { "type": "yesno", "fact": "recorded", "sum": "相談の記録", "text": "相談した日時・相手の部署（名前）・回答の内容を、記録していますか？", "next": "d_problems" },
    "d_problems": { "type": "multi", "fact": "problems", "sum": "困っていること", "optionSet": "problems", "text": "困っていることは？（いくつでも）", "next": "d_type" },
    "d_type": {
      "type": "choice",
      "fact": "biz_type",
      "sum": "営業の種類",
      "text": "その施設の営業の種類はわかりますか？",
      "help": "玄関の[[標識]]に「住宅宿泊事業届出住宅」とあれば、届出の民泊です。わからなければ「わからない」で大丈夫です。",
      "options": [
        { "value": "jutaku", "label": "届出の民泊（住宅宿泊事業）", "short": "届出の民泊" },
        { "value": "ryokan", "label": "旅館業の許可を受けた施設（簡易宿所など）", "short": "旅館業の施設" },
        { "value": "tokku", "label": "特区民泊", "short": "特区民泊" },
        { "value": "unknown", "label": "わからない", "short": "営業の種類は不明" }
      ],
      "next": "@result"
    },
    "e_what": {
      "type": "multi",
      "fact": "rule_goal",
      "sum": "変えたいこと",
      "text": "どんなルールにしたいですか？（いくつでも）",
      "options": [
        { "value": "area_limit", "label": "営業できる場所や期間を制限したい", "short": "場所・期間の制限" },
        { "value": "prior_notice", "label": "開業前に近所へ説明することを義務にしたい", "short": "開業前の説明" },
        { "value": "complaint", "label": "苦情があったときの対応（駆けつけなど）を強めたい", "short": "苦情対応の強化" },
        { "value": "enforcement", "label": "無許可営業の取り締まりを強めたい", "short": "取り締まりの強化" },
        { "value": "disclosure", "label": "施設の一覧などの情報公開を進めたい", "short": "情報公開" },
        { "value": "undecided", "label": "まだ決めていない", "short": "未定", "exclusive": true }
      ],
      "next": "e_checked_rule"
    },
    "e_checked_rule": { "type": "yesno", "fact": "checked_rule", "sum": "今のルールの確認", "text": "今の自治体の民泊のルール（[[条例]]など）を確認しましたか？", "next": "e_allies" },
    "e_allies": { "type": "yesno", "fact": "allies", "sum": "仲間", "text": "同じ考えの住民や町内会など、一緒に動ける人はいますか？", "next": "e_pubcome" },
    "e_pubcome": { "type": "yesno", "fact": "pubcome_open", "sum": "意見募集", "text": "自治体で、民泊のルールについての意見募集（[[パブコメ]]）が行われていますか？", "next": "e_method" },
    "e_method": {
      "type": "choice",
      "fact": "rule_method",
      "sum": "取りたい方法",
      "text": "どの方法で進めたいですか？",
      "options": [
        { "value": "giin", "label": "地元の議員に相談する", "short": "議員に相談" },
        { "value": "petition", "label": "[[陳情・請願]]を出す", "short": "陳情・請願" },
        { "value": "pubcome", "label": "意見募集（パブコメ）に意見を出す", "short": "パブコメ" },
        { "value": "shomei", "label": "署名を集める", "short": "署名" },
        { "value": "undecided", "label": "まだ分からない", "short": "方法は未定" }
      ],
      "next": "@result"
    }
  }
}
